# --- Environment Variables Template ---
# Copy this file to .env and fill in the values.
# Every *_HOST_PATH defaults to ./data/<service> inside the repo (gitignored).
# Point them at bigger or faster disks if you load the full datasets.

COMPOSE_PROJECT_NAME=osint_platform

# --- Database (Postgres) ---
POSTGRES_USER=osint_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=osint_metadata
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXPOSE_PORT=5432
POSTGRES_DATA_HOST_PATH=./data/postgres
# Memory tuning sized for a 16-32 GB host. On a 64 GB host loading the full
# CNPJ dataset, the author uses: SHM_SIZE=17g SHARED_BUFFERS=16GB
# EFFECTIVE_CACHE_SIZE=48GB WORK_MEM=64MB MAINTENANCE_WORK_MEM=2GB
# MAX_WORKER_PROCESSES=8 MAX_PARALLEL_WORKERS=8 MAX_PARALLEL_WORKERS_PER_GATHER=4
# WAL_BUFFERS=64MB MIN_WAL_SIZE=1GB MAX_WAL_SIZE=4GB
POSTGRES_SHM_SIZE=2g
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=8GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=1GB
POSTGRES_RANDOM_PAGE_COST=1.1
POSTGRES_EFFECTIVE_IO_CONCURRENCY=200
POSTGRES_MAX_WORKER_PROCESSES=4
POSTGRES_MAX_PARALLEL_WORKERS=4
POSTGRES_MAX_PARALLEL_WORKERS_PER_GATHER=2
POSTGRES_WAL_BUFFERS=16MB
POSTGRES_MIN_WAL_SIZE=512MB
POSTGRES_MAX_WAL_SIZE=2GB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9
POSTGRES_DEFAULT_STATISTICS_TARGET=200
POSTGRES_HUGE_PAGES=try

# --- Graph Database (Neo4j) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_graph_password_here
NEO4J_URI=bolt://neo4j:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_DATA_HOST_PATH=./data/neo4j
# 64 GB host profile: PAGECACHE_SIZE=6g HEAP_SIZE=4g TX_MEMORY=2g
NEO4J_PAGECACHE_SIZE=2g
NEO4J_HEAP_SIZE=2g
NEO4J_TX_MEMORY=1g
NEO4J_TX_LOG_RETENTION_POLICY=2 files
NEO4J_CHECKPOINT_INTERVAL_TX=50

# --- Object Storage (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_DATA_HOST_PATH=./data/minio
# Host ports only. Containers always reach MinIO at minio:9000.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_this_minio_password
MINIO_REGION=us-east-1

# --- Backend ---
BACKEND_PORT=8000

# --- Frontend App Runtime ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=
FRONTEND_PORT=3000

# --- Keycloak Authentication ---
KEYCLOAK_AUTH_ENABLED=true
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=osint-platform
KEYCLOAK_CLIENT_ID=osint-frontend
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change_this_keycloak_admin_password
VITE_KEYCLOAK_ENABLED=true
VITE_KEYCLOAK_URL=http://localhost:8081

# --- Shared Geo Loader ---
GEOBR_YEAR=2019
GEOBR_SIMPLIFIED=true

# --- Airflow ---
# UID the Airflow containers run as. If you point AIRFLOW_DATA_HOST_PATH at an
# existing directory you own, set this to your own UID (`id -u`) so Airflow can write there.
AIRFLOW_UID=50000
AIRFLOW_DATA_HOST_PATH=./data/airflow/data
AIRFLOW_TEMP_SSD_HOST_PATH=./data/airflow/temp_ssd
AIRFLOW_PORT=8080
# Encrypts stored connections and variables. Leave empty for local use, or generate one:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
TZ=America/Sao_Paulo

# --- Cloudflare Tunnel (compose.tunnel.yml, optional) ---
# Obtain from: Zero Trust dashboard → Networks → Tunnels → your tunnel → Configure → Token
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
# Public hostnames configured in the tunnel ingress / DNS
CF_APP_DOMAIN=app.yourdomain.com
CF_API_DOMAIN=api.yourdomain.com
CF_AUTH_DOMAIN=auth.yourdomain.com
CF_AIRFLOW_DOMAIN=airflow.yourdomain.com
# When serving through the tunnel over HTTPS, replace the matching values above with:
# VITE_API_URL=https://api.yourdomain.com
# KEYCLOAK_PUBLIC_URL=https://auth.yourdomain.com
# VITE_KEYCLOAK_URL=https://auth.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://app.yourdomain.com,http://localhost:3000,http://127.0.0.1:3000
