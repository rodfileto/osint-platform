[Unit]
Description=OSINT Platform Airflow Stack
Requires=docker.service
After=docker.service network-online.target osint-platform-local.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/docker compose --env-file @REPO_DIR@/.env -f @REPO_DIR@/docker-compose.yml -f @REPO_DIR@/compose.prod.yml --profile airflow up -d airflow-webserver airflow-scheduler airflow-triggerer
ExecStop=/usr/bin/docker compose --env-file @REPO_DIR@/.env -f @REPO_DIR@/docker-compose.yml -f @REPO_DIR@/compose.prod.yml stop airflow-webserver airflow-scheduler airflow-triggerer
RemainAfterExit=yes
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
